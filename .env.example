NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/snta-service

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Demo seed values. Required only when running npm run seed:demo.
SEED_CONFIRM=
SEED_ADMIN_NAME=Luma Demo Admin
SEED_ADMIN_EMAIL=demo-admin@example.com
SEED_ADMIN_PASSWORD=change-this-demo-password
SEED_USER_NAME=Luma Demo Writer
SEED_USER_EMAIL=demo-writer@example.com
SEED_USER_PASSWORD=change-this-demo-password
