{
  "info": {
    "name": "Secure Note-Taking Application API",
    "description": "Postman collection for the Secure Note-Taking Application backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Service health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Error handling",
      "item": [
        {
          "name": "Unknown route",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/does-not-exist",
              "host": ["{{baseUrl}}"],
              "path": ["does-not-exist"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
